# Copy this file to server/.env and provide real local values.
# The client never receives these values.

NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://root@127.0.0.1:3306/mosito_portfolio"
SESSION_SECRET="replace-with-at-least-32-random-characters"
SESSION_COOKIE_NAME=mosito_session
SESSION_TTL_HOURS=8
CLIENT_ORIGIN=http://localhost:5173
SITE_URL=http://localhost:4000
STORAGE_DIR=../storage
LOG_LEVEL=info

# The first administrator is created with: npm run admin:init
# These values are only read by that command. Remove them afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Mosito Qhasho

# SMTP is optional in development. Contact messages are always stored in MySQL.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Mosito Portfolio <portfolio@example.com>"
CONTACT_NOTIFICATION_EMAIL=

# Rate limits
LOGIN_RATE_LIMIT_MAX=10
CONTACT_RATE_LIMIT_MAX=5
